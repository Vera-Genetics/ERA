# Copy to .env.production on the deploy host and fill in real values.
# .env.production is gitignored - never commit it.
#
#   cp .env.production.example .env.production
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build

# --- Generate these two with `openssl rand -hex 64` / `openssl rand -hex 32` ---
SECRET_KEY_BASE=
CIVIC_API_HMAC_KEY=

# --- Postgres password (any random string; `openssl rand -hex 16`) ---
POSTGRES_PASSWORD=

# --- OAuth (optional at first boot - leave blank and sign-in just won't work
# until these are set; nothing crashes). Register each app's callback URL as
# https://eradb.org/api/auth/<provider>/callback ---
CIVIC_GITHUB_KEY=
CIVIC_GITHUB_SECRET=
CIVIC_GOOGLE_KEY=
CIVIC_GOOGLE_SECRET=
CIVIC_ORCID_KEY=
CIVIC_ORCID_SECRET=
