# syntax=docker/dockerfile:1
#
# Production image for ERA: builds the Angular client straight into
# server/public (same layout `yarn build` uses natively), precompiles Rails
# assets, and ships a single self-contained Rails container that serves both
# the SPA and the GraphQL API. Build context is the repo root (both client/
# and server/ are needed for the Angular outputPath "../server/public" to
# land in the right place).
#
#   docker build -f server/Dockerfile.production -t era:production .

# ---- stage 1: build the Angular client into server/public ----
FROM node:22-bookworm AS client-build
WORKDIR /app
COPY client/package.json client/yarn.lock client/
RUN cd client && yarn install --frozen-lockfile
COPY client/ client/
# Only an empty output dir is needed here (Angular's outputPath is
# "../server/public" relative to client/) - copying the rest of server/ would
# invalidate this stage's cache, and force a client rebuild, on every backend
# code change.
RUN mkdir -p server/public
RUN cd client && yarn build

# ---- stage 2: ruby base ----
# Hardcoded rather than an ARG-before-FROM: some non-BuildKit (legacy) Docker
# builders mis-resolve that pattern across stages and fail with
# "invalid reference format".
FROM ruby:4.0.1-slim AS base
WORKDIR /rails
ENV RAILS_ENV=production \
    BUNDLE_PATH=/usr/local/bundle \
    BUNDLE_WITHOUT="development:test" \
    BUNDLE_DEPLOYMENT="1"
RUN gem update --system --no-document && gem install -N bundler

# ---- stage 3: build gems + precompile assets ----
FROM base AS build
RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y \
      build-essential curl git libcurl4-openssl-dev libpq-dev \
      libvips-dev libyaml-dev node-gyp pkg-config python-is-python3 && \
    rm -rf /var/lib/apt/lists/*

COPY server/Gemfile server/Gemfile.lock ./
RUN bundle install && \
    bundle exec bootsnap precompile --gemfile && \
    rm -rf ~/.bundle/ $BUNDLE_PATH/ruby/*/cache $BUNDLE_PATH/ruby/*/bundler/gems/*/.git

COPY server/ .
# Don't rely on git having preserved the executable bit (it keeps getting lost
# across Windows/macOS checkouts of this repo) - set it explicitly instead.
RUN chmod +x bin/docker-entrypoint bin/rails
# Overlay the Angular build from stage 1 (COPY server/ above already brought
# in the stale git-committed public/, this replaces it with the fresh build).
COPY --from=client-build /app/server/public ./public

RUN bundle exec bootsnap precompile app/ lib/
# SECRET_KEY_BASE_DUMMY lets assets:precompile run without a real production
# secret (same trick .github/workflows/build_frontend.yml uses).
RUN SECRET_KEY_BASE_DUMMY=1 bundle exec rails assets:precompile

# ---- stage 4: runtime ----
FROM base
RUN apt-get update -qq && \
    apt-get install --no-install-recommends -y \
      curl imagemagick libjemalloc2 libvips postgresql-client && \
    rm -rf /var/lib/apt/lists /var/cache/apt/archives

COPY --from=build /usr/local/bundle /usr/local/bundle
COPY --from=build /rails /rails

RUN useradd rails --create-home --shell /bin/bash && \
    chown -R rails:rails db log storage tmp public
USER rails:rails

ENV LD_PRELOAD="libjemalloc.so.2" \
    MALLOC_CONF="dirty_decay_ms:1000,narenas:2,background_thread:true" \
    RAILS_LOG_TO_STDOUT="1" \
    RAILS_SERVE_STATIC_FILES="true" \
    RUBY_YJIT_ENABLE="1"

ENTRYPOINT ["/rails/bin/docker-entrypoint"]
EXPOSE 3000
CMD ["./bin/rails", "server", "-b", "0.0.0.0", "-p", "3000"]
